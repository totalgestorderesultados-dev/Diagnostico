rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net (Default Deny Catch-All)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "edsonfinanceiro2017@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['id', 'submittedAt', 'userData', 'answers', 'completed', 'lastActiveTravaIndex', 'userId']) &&
             data.id is string &&
             data.submittedAt is string &&
             data.userData is map &&
             data.userData.name is string &&
             data.userData.name.size() > 0 &&
             data.userData.name.size() < 100 &&
             data.userData.phone is string &&
             data.userData.phone.size() > 0 &&
             data.userData.phone.size() < 30 &&
             data.answers is map &&
             data.completed is bool &&
             (data.lastActiveTravaIndex is int || data.lastActiveTravaIndex is float) &&
             data.userId is string;
    }

    match /submissions/{submissionId} {
      // Allow creator (anonymous or authenticated) to create and update their own document
      allow create: if isAuthenticated() && 
                    isValidSubmission(request.resource.data) && 
                    request.resource.data.userId == request.auth.uid;
                    
      allow update: if isAuthenticated() && 
                    isValidSubmission(request.resource.data) && 
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid;

      // Only admin can list/read all or delete
      // Allow user to read their own document if needed
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
